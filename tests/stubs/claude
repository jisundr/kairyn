#!/usr/bin/env python3
"""A stand-in for `claude -p` in afk.py tests. It acts on the prompt, never calls a model.

STUB_LOG: file that gets one line per call (the prompt). STUB_LOG.args gets the other arguments,
STUB_LOG.cwd the directory the session runs in, STUB_LOG.env its KAIRYN_MILESTONES.
STUB_MODE: good (default) | no_red (the test passes before the code exists)
  | weaken (the feat commit edits the test) | add_test (the feat commit only adds to the test) | noqa (the feat commit adds `# noqa`)
  | review_fixable (one finding, gone after the fix round) | review_stuck (the finding stays)
  | budget (the session runs out of --max-budget-usd, as the real CLI reports it)
  | gate_fail (an AI gate check prints FAIL). Gate-check prompts say "gate check".
Reviewer prompts say "reviewer": the stub prints findings. Fix-round prompts say "fix round".
With --output-format json it prints {"result", "total_cost_usd"}: STUB_COST (default 0.25) per call.
STUB_SLEEP: seconds to sleep first (to hit a time limit).
Build prompts name `T<n>`: the stub makes the test(T<n>) and feat(T<n>) commits.
Review prompts name REVIEW.md: the stub writes REVIEW.md with `Decision: pending` in the task folder the
prompt names (a full path for a child-repo task, whose session runs in the child worktree).
"""
import os
import re
import subprocess
import sys
from pathlib import Path

args = sys.argv[1:]
prompt = args[args.index("-p") + 1] if "-p" in args else ""
with open(os.environ["STUB_LOG"], "a") as log:
    log.write(prompt.replace("\n", " ") + "\n")
with open(os.environ["STUB_LOG"] + ".args", "a") as log:
    log.write(" ".join(a for a in args if a != prompt) + "\n")
with open(os.environ["STUB_LOG"] + ".cwd", "a") as log:
    log.write(os.getcwd() + "\n")
with open(os.environ["STUB_LOG"] + ".env", "a") as log:
    log.write("KAIRYN_MILESTONES=" + os.environ.get("KAIRYN_MILESTONES", "") + "\n")
mode = os.environ.get("STUB_MODE", "good")
import time
time.sleep(float(os.environ.get("STUB_SLEEP", "0")))
said = []


def commit(msg, files):
    for name, text in files.items():
        Path(name).write_text(text)
    subprocess.run(["git", "add", *files], check=True)
    subprocess.run(["git", "commit", "-q", "-m", msg], check=True)


folder = re.search(r"(\S*docs/tasks/([\w-]+))", prompt)
task = folder.group(2)
build = re.search(r"\b(T\d+)\b", prompt) if "BUILD.md" in prompt else None
if "gate check" in prompt:
    said.append("FAIL: no log line for the new path" if mode == "gate_fail" else "PASS")
elif "reviewer" in prompt:
    count = Path(os.environ["STUB_LOG"] + ".reviews")
    n = int(count.read_text()) + 1 if count.exists() else 1
    count.write_text(str(n))
    if mode == "review_stuck" or (mode == "review_fixable" and n == 1):
        said.append("FINDING: feature_t1.VALUE has no test for 0.")
    else:
        said.append("FINDINGS: none")
elif "fix round" in prompt:
    commit("fix: cover VALUE 0", {"feature_t1.py": "VALUE = 1  # fixed\n"})
elif build:
    n = build.group(1).lower()
    check = {f"check_{n}.py": f"import feature_{n}\n"}
    feature = {f"feature_{n}.py": "VALUE = 1\n"}
    if mode == "weaken":
        commit(f"test({build.group(1)}): add check", check)
        commit(f"feat({build.group(1)}): add feature", {**feature, f"check_{n}.py": "pass\n"})
    elif mode == "add_test":
        commit(f"test({build.group(1)}): add check", check)
        commit(f"feat({build.group(1)}): add feature", {**feature, f"check_{n}.py": f"import feature_{n}\nassert True\n"})
    elif mode == "noqa":
        commit(f"test({build.group(1)}): add check", check)
        commit(f"feat({build.group(1)}): add feature", {f"feature_{n}.py": "VALUE = 1  # noqa: E501\n"})
    elif mode == "no_red":
        commit(f"test({build.group(1)}): add check", {**check, **feature})
        commit(f"feat({build.group(1)}): no-op", {f"feature_{n}.py": "VALUE = 2\n"})
    else:
        commit(f"test({build.group(1)}): add check", check)
        commit(f"feat({build.group(1)}): add feature", feature)
elif "REVIEW.md" in prompt:
    Path(folder.group(1), "REVIEW.md").write_text(
        f"---\ntask: {task}\nstage: review\nsummary: \"stub review\"\n---\n\n# Review\n\nDecision: pending\n")

text = "\n".join(said)
if mode == "budget":   # what the real CLI prints when --max-budget-usd runs out (seen 2026-11-23)
    import json
    print(json.dumps({"type": "result", "subtype": "error_max_budget_usd", "is_error": True, "result": "",
                      "errors": ["Reached maximum budget ($0.01)"], "total_cost_usd": 0.13}))
    sys.exit(1)
if "json" in args:
    import json
    print(json.dumps({"type": "result", "result": text, "total_cost_usd": float(os.environ.get("STUB_COST", "0.25"))}))
elif text:
    print(text)
