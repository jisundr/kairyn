#!/usr/bin/env python3
"""A stand-in for `gh` in afk.py tests. GH_LOG gets one line of arguments per call.

pr create prints a pull request URL and remembers it; pr view exits 0 only after a create.
GH_MODE=merge_fail makes pr merge exit 1.
"""
import os
import sys
from pathlib import Path

log = Path(os.environ["GH_LOG"])
with log.open("a") as f:
    f.write(" ".join(sys.argv[1:]) + "\n")
created = log.with_suffix(".created")
cmd = sys.argv[1:3]
if cmd == ["pr", "create"]:
    created.write_text("1")
    print("https://github.com/example/repo/pull/1")
elif cmd == ["pr", "view"]:
    if not created.exists():
        print("no pull requests found", file=sys.stderr)
        sys.exit(1)
    print("https://github.com/example/repo/pull/1")
elif cmd == ["pr", "merge"] and os.environ.get("GH_MODE") == "merge_fail":
    print("Pull request is not mergeable: the base branch policy prohibits the merge", file=sys.stderr)
    sys.exit(1)
