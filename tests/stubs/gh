#!/usr/bin/env python3
"""A stand-in for `gh` in afk.py tests. GH_LOG gets one line of arguments per call, GH_LOG.cwd the cwd.

pr create prints a pull request URL and remembers it for its cwd; pr view exits 0 only after a create
in the same cwd (one pull request per repo). GH_MODE=merge_fail makes pr merge exit 1;
merge_fail_after_first lets only the first pr merge pass. pr view --json state prints MERGED after a merge in that cwd.
pr view --json headRefOid,statusCheckRollup reports the pushed branch tip with one passing check. GH_CHECKS changes that:
pending:<n> (the first n polls pending), fail, none (no checks), stale:<n> (the first n polls show the old head).
"""
import json
import os
import subprocess
import sys
from pathlib import Path

log = Path(os.environ["GH_LOG"])
cwd = os.path.realpath(os.getcwd())
with log.open("a") as f:
    f.write(" ".join(sys.argv[1:]) + "\n")
with open(str(log) + ".cwd", "a") as f:
    f.write(cwd + "\n")
created = log.with_suffix(".created")
merged_file = log.with_suffix(".merged")
merged = merged_file.read_text().splitlines() if merged_file.exists() else []
made = created.read_text().splitlines() if created.exists() else []
cmd = sys.argv[1:3]
if cmd == ["pr", "create"]:
    created.write_text("\n".join(made + [cwd]) + "\n")
    print("https://github.com/example/repo/pull/1")
elif cmd == ["pr", "view"] and "statusCheckRollup" in " ".join(sys.argv):
    polls_file = log.with_suffix(".polls")
    polls = int(polls_file.read_text()) if polls_file.exists() else 0
    polls_file.write_text(str(polls + 1))
    mode, _, n = os.environ.get("GH_CHECKS", "").partition(":")
    tip = subprocess.run(["git", "rev-parse", f"refs/remotes/origin/{sys.argv[3]}" + ("~1" if mode == "stale" and polls < int(n) else "")],
                         capture_output=True, text=True).stdout.strip()
    check = {"__typename": "CheckRun", "name": "tests", "status": "COMPLETED", "conclusion": "SUCCESS"}
    if mode == "pending" and polls < int(n):
        check = {**check, "status": "IN_PROGRESS", "conclusion": ""}
    elif mode == "fail":
        check = {**check, "conclusion": "FAILURE"}
    print(json.dumps({"headRefOid": tip, "statusCheckRollup": [] if mode == "none" else [check]}))
elif cmd == ["pr", "view"]:
    if cwd not in made:
        print("no pull requests found", file=sys.stderr)
        sys.exit(1)
    print(("MERGED" if cwd in merged else "OPEN") if "state" in sys.argv else "https://github.com/example/repo/pull/1")
elif cmd == ["pr", "merge"]:
    mode = os.environ.get("GH_MODE")
    if mode == "merge_fail" or (mode == "merge_fail_after_first" and merged):
        print("Pull request is not mergeable: the base branch policy prohibits the merge", file=sys.stderr)
        sys.exit(1)
    merged_file.write_text("\n".join(merged + [cwd]) + "\n")
